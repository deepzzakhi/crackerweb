# Producción (Neon/Supabase): SIEMPRE con TLS y límite de conexiones.
DATABASE_URL=postgresql://user:pass@host:5432/crackerweb_db?sslmode=require&connection_limit=5
# Mínimo 32 caracteres aleatorios: openssl rand -base64 48
JWT_SECRET=<random-long-secret-min-32-chars>
FRONTEND_URL=https://crackerweb.vercel.app
PORT=4002
NODE_ENV=production
# Hops de proxy confiables (Render = 1).
TRUST_PROXY=1
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
