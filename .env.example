# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://cracker:*****@localhost:5435/cracker_db

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_here

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
