# ───────────────────────────── Database ─────────────────────────────
# Local (docker compose, sin TLS). Elegí tu propia contraseña y usala en las dos líneas.
POSTGRES_PASSWORD=*****
DATABASE_URL=postgresql://cracker:*****@localhost:5435/cracker_db
# Producción (Neon/Supabase): SIEMPRE con TLS y límite de conexiones.
# DATABASE_URL=postgresql://user:pass@host:5432/cracker_db?sslmode=require&connection_limit=5

# ───────────────────────────── Auth ─────────────────────────────
# Mínimo 32 caracteres aleatorios: openssl rand -base64 48
JWT_SECRET=your_super_secret_jwt_key_here
# Demo del dashboard con datos ficticios (token firmado de 2 h). false para apagarla.
DEMO_MODE=true

# ───────────────────────────── Google OAuth ─────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ───────────────────────────── Chat con IA ─────────────────────────────
# Sin key, el chat ofrece WhatsApp directo. Para bajar costos: CHAT_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-opus-5-5

# ───────────────────────────── Server ─────────────────────────────
PORT=4002
NODE_ENV=development
# Una o varias URLs separadas por coma
FRONTEND_URL=http://localhost:5173
# Hops de proxy confiables (Render = 1). En local dejar 0. Nunca "true".
TRUST_PROXY=0

# ───────────────────────────── Frontend (Vercel) ─────────────────────────────
# URL del backend en Render, sin barra final (ej.: https://crackerweb-backend.onrender.com)
VITE_API_URL=
VITE_GOOGLE_CLIENT_ID=
# WhatsApp Business al que deriva el chat (formato internacional, sin + ni espacios)
VITE_WHATSAPP_NUMBER=5491127585783
